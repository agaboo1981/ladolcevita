# Copy to .env to configure a deployment. All values are optional; the defaults
# below are what the site falls back to.

# Public base URL, used by robots.txt and sitemap.xml and by the API CORS allowlist.
SITE_URL=https://ladolcevita-seven.vercel.app

# Optional API base, for a front end and back end on different origins.
# Leave empty when both are served from the same origin.
VITE_API_BASE=

# Optional comma-separated CORS origins for the API.
ALLOWED_ORIGINS=

# API port.
PORT=3001

# Optional override for the sitemap lastmod date (YYYY-MM-DD).
SITEMAP_LASTMOD=
